{"$defs":{"EvaluationV10":{"additionalProperties":false,"description":"Final decoding settings plus a bounded routine-evaluation budget.","properties":{"every_steps":{"exclusiveMinimum":0,"title":"Every Steps","type":"integer"},"max_new_tokens":{"exclusiveMinimum":0,"title":"Max New Tokens","type":"integer"},"routine":{"$ref":"#/$defs/RoutineEvaluation"},"samples":{"default":3,"minimum":0,"title":"Samples","type":"integer"}},"required":["every_steps","max_new_tokens","routine"],"title":"EvaluationV10","type":"object"},"FileRef":{"additionalProperties":false,"description":"Immutable staged file located beneath the worker input directory.","properties":{"path":{"title":"Path","type":"string"},"sha256":{"pattern":"^[0-9a-f]{64}$","title":"Sha256","type":"string"}},"required":["path","sha256"],"title":"FileRef","type":"object"},"Optimizer":{"additionalProperties":false,"description":"Constant-rate AdamW settings included in resume identity.","properties":{"beta1":{"default":0.9,"exclusiveMaximum":1,"minimum":0,"title":"Beta1","type":"number"},"beta2":{"default":0.95,"exclusiveMaximum":1,"minimum":0,"title":"Beta2","type":"number"},"clip":{"default":1.0,"exclusiveMinimum":0,"title":"Clip","type":"number"},"eps":{"default":1e-08,"exclusiveMinimum":0,"title":"Eps","type":"number"},"learning_rate":{"default":1e-05,"exclusiveMinimum":0,"title":"Learning Rate","type":"number"},"weight_decay":{"default":0.01,"minimum":0,"title":"Weight Decay","type":"number"}},"title":"Optimizer","type":"object"},"PackedSftLimits":{"additionalProperties":false,"description":"Optional early stop and the committed checkpoint cadence.\n\nThe optimizer-update count is derived from the packed rows of one\ntraining epoch. ``max_steps`` may stop the run before that count but it\nnever reshapes an update.","properties":{"checkpoint_every_steps":{"default":100,"exclusiveMinimum":0,"title":"Checkpoint Every Steps","type":"integer"},"max_steps":{"anyOf":[{"exclusiveMinimum":0,"type":"integer"},{"type":"n